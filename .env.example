# Ar-Rahmah Care — Environment Configuration
# Default mode: Local SQLite + Sandbox Payment Simulator

DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication Secret (Key for JOSE JWT Session)
AUTH_SECRET="ar-rahmah-care-dev-secret-super-safe-key-change-in-prod-2026"

# Payment Gateway Configuration
# Mode: "mock" (built-in simulator) or "midtrans" (official merchant sandbox/production)
PAYMENT_PROVIDER="mock"
PAYMENT_ENV="sandbox"
ENABLE_LIVE_PAYMENTS="false"

# Midtrans Credentials (isi bila beralih ke Midtrans Snap Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-demo-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-demo-key"
MIDTRANS_IS_PRODUCTION="false"

# Feature Switches
ENABLE_DONATION_CHECKOUT="true"
ENABLE_MANUAL_BANK_TRANSFER="true"
ENABLE_ZAKAT="false"
ENABLE_WAKAF="false"
ENABLE_QURBAN="false"
ENABLE_DONOR_PORTAL="false"
